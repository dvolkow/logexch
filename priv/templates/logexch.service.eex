[Unit]
Description=Logexch (Nginx log to Clickhouse)
After=network.target

[Service]
Type=simple
User=<%= @user %>
Group=<%= @group %>
WorkingDirectory=<%= @install_dir %>
ExecStart=<%= @install_dir %>/bin/logexch_release start
ExecStop=<%= @install_dir %>/bin/logexch_release stop
Restart=on-failure
RestartSec=5
KillMode=process
SyslogIdentifier=logexch

[Install]
WantedBy=multi-user.target
